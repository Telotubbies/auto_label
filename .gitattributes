*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text

# Shell scripts must keep LF line endings (they run under bash/WSL2).
*.sh text eol=lf
*.bash text eol=lf

# Generated contract artifacts are compared byte-for-byte by the build checks.
apps/backend/openapi.json text eol=lf
*.gen.ts text eol=lf
