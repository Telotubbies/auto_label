# Public domain pointing at this VM (A record). Caddy issues HTTPS for it and api.<domain>.
LD_DOMAIN=labeldesk.example.com

# Generate each with:  openssl rand -hex 32
LD_SECRET=change-me
POSTGRES_PASSWORD=change-me
LD_WORKER_TOKEN=change-me

# Web on Vercel? list its origin(s) here, comma separated.
# LD_CORS_ORIGINS=https://labeldesk.vercel.app

# Jobs this worker claims. drift and active_learning are included by default: drift only needs the
# project images on the shared volume, and active_learning re-runs the trained model (CPU is fine,
# slow). Add ",train,autolabel" if this VM should train on CPU when no GPU worker is connected.
# active_learning needs a worker that can load the model — keep it on the worker service, not the API.
LD_LOCAL_JOBS=version,export,export_engine,health,connector_sync,retention,extract_frames,track_forward,drift,active_learning,insights_images,insights_leakage,insights_embedding

# Who runs train/autolabel: "remote" = the pip GPU worker (labeldesk-worker, YOLO + size only),
# Optional override; leave empty (the default) to follow the online workers. A worker service
# that claims train/autolabel in LD_LOCAL_JOBS above unlocks non-YOLO families, max_minutes and
# resume_from; "remote" forces the pip GPU worker's v1 restrictions.
LD_TRAIN_WORKER=

# Self-hosted inference profile (optional): docker compose --profile inference up -d --build
# Point this at a directory of exported .onnx/.pt/.engine files; it is mounted read-only at /models.
LD_INFERENCE_MODELS_DIR=./models
LD_INFERENCE_PORT=8010

LD_SIGNUP_ENABLED=1
LD_SEED_DEMO=0
# Emails allowed to change workspace plans (no billing provider is wired).
LD_SUPERADMINS=

# Mail. Without LD_SMTP_HOST the API logs mail and (in local development) captures it for /__mail.
LD_SMTP_HOST=
LD_SMTP_PORT=587
LD_SMTP_USER=
LD_SMTP_PASSWORD=
LD_SMTP_FROM="LabelDesk <no-reply@labeldesk.example.com>"
LD_SMTP_TLS=1

# Dev mail inbox (GET /__mail) is fail-closed: it opens only when LD_MAIL_DEV=1 AND LD_PUBLIC_URL is
# http://localhost or http://127.0.0.1. It prints live reset links — never enable it in production.
# Both are left empty here; LD_ENV=production also disables the demo seed.
LD_MAIL_DEV=
LD_ENV=production

# Connectors: hosted (multi-tenant) deployments refuse a custom S3 endpoint_url or Azure account_url
# because the cloud SDK resolves the host again (SSRF). Set 0 only for a single-tenant self-host.
LD_MULTI_TENANT=1
