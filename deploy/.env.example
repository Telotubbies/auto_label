# Public domain pointing at this VM (A record). Caddy issues HTTPS for it and api.<domain>.
LD_DOMAIN=labeldesk.example.com

# Generate each with:  openssl rand -hex 32
LD_SECRET=change-me
POSTGRES_PASSWORD=change-me
LD_WORKER_TOKEN=change-me

# Web on Vercel? list its origin(s) here, comma separated.
# LD_CORS_ORIGINS=https://labeldesk.vercel.app

# Jobs the API runs itself. Add ",train,autolabel" if this VM should train on CPU
# when no GPU worker is connected (slow but works).
LD_LOCAL_JOBS=version,export

LD_SIGNUP_ENABLED=1
LD_SEED_DEMO=0
# Emails allowed to change workspace plans (no billing provider is wired).
LD_SUPERADMINS=

# Outbound mail (password resets, verification, invites). Without LD_SMTP_HOST the API logs mail and
# captures it in memory; the production stack closes that inbox via LD_ENV=production.
LD_SMTP_HOST=
LD_SMTP_PORT=587
LD_SMTP_USER=
LD_SMTP_PASSWORD=
LD_SMTP_FROM="LabelDesk <no-reply@labeldesk.example.com>"
LD_SMTP_TLS=1
